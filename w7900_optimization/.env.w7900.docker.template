# Standalone Docker build based on the validated AMD ROCm vLLM 0.23 image.
W7900_BASE_IMAGE=rocm/vllm:rocm7.14.0_rdna_ubuntu24.04_py3.14_pytorch_2.11.0_vllm_0.23.0
VLLM_VERSION_OVERRIDE=0.23.1.dev1
MAX_JOBS=8

# Host directory mounted read-only at /models. Point the two container paths
# below at snapshots/directories containing config.json.
VLLM_HOST_MODELS_DIR=/absolute/path/to/models
VLLM_TARGET_MODEL=/models/Qwen3.6-27B-AWQ-INT4
VLLM_DRAFT_MODEL=/models/Qwen3.6-27B-DFlash

VLLM_HOST_PORT=8000
W7900_VISIBLE_DEVICES=0,1
VLLM_TENSOR_PARALLEL_SIZE=2
VLLM_DRAFT_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTIL=0.80
VLLM_MAX_MODEL_LEN=131072
VLLM_MAX_NUM_BATCHED_TOKENS=16384
VLLM_MAX_NUM_SEQS=1
VLLM_KV_CACHE_DTYPE=fp8
VLLM_ATTENTION_BACKEND=TRITON_ATTN
VLLM_TRITON_ATTN_PREFILL_TILE_SIZE=16
VLLM_DFLASH_N=8
VLLM_DISABLE_DFLASH=0
VLLM_ENFORCE_EAGER=1

VLLM_HOST_TRITON_CACHE=./.triton-cache-w7900
VLLM_HOST_VLLM_CACHE=./.vllm-cache-w7900
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
