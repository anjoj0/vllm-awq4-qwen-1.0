+        _, top_indices = torch.topk(cumulative_logprobs, k=num_keep)
+        keep_lens = torch.zeros(
+            batch_size, dtype=torch.int32, device=self.device
+        )
+        keep_lens.scatter_add_(
+            0,
+            top_indices // num_draft_tokens,
