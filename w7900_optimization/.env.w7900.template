# Existing AMD container local workflow; no Docker/ROCm version pins here.
VLLM_WORKTREE=/workspace/vllm-w7900-023
VLLM_TARGET_MODEL=/workspace/cyankiwi--Qwen3.6-27B-AWQ-INT4/snapshots/master
VLLM_DRAFT_MODEL=/workspace/z-lab--Qwen3.6-27B-DFlash/snapshots/master
VLLM_LONGTEXT=/workspace/bench_data/combined_papers_for_llm.txt
VLLM_HOST_PORT=8000
VLLM_SERVED_MODEL_NAME=Qwen3.6-27B-AWQ4
W7900_VISIBLE_DEVICES=0,1
VLLM_TENSOR_PARALLEL_SIZE=2
VLLM_DRAFT_TENSOR_PARALLEL_SIZE=1
VLLM_KV_CACHE_DTYPE=fp8
VLLM_GPU_MEMORY_UTIL=0.80
VLLM_MAX_MODEL_LEN=131072
VLLM_MAX_NUM_BATCHED_TOKENS=16384
VLLM_MAX_NUM_SEQS=1
VLLM_DFLASH_N=8
VLLM_DISABLE_DFLASH=0
VLLM_ATTENTION_BACKEND=TRITON_ATTN

# Bring-up can set this to 1. Performance runs should test graph mode with 0.
VLLM_ENFORCE_EAGER=0

# W7900 Triton unified-attention knobs.
# Experiments on 8x Radeon PRO W7900D (gfx1100) show prefill tile=16 is the
# best long-context default among 16/32/64:
# - BF16 L470k: 165.16s (default 32) -> 88.98s (tile 16)
# - AWQ4 L470k: 181.86s (default 32) -> 115.17s (tile 16)
# Set this back to 32 to reproduce upstream default behavior.
VLLM_TRITON_ATTN_PREFILL_TILE_SIZE=16
# VLLM_TRITON_ATTN_DECODE_TILE_SIZE=32
# VLLM_TRITON_ATTN_MIN_2D_GRID=128
# VLLM_TRITON_ATTN_SOFTMAX_SEGMENTS=16
