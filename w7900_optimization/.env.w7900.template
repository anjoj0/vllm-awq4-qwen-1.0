# Copy to .env on the W7900 machine, then edit paths and optional tuning values.

VLLM_HOST_MODELS_DIR=/absolute/path/to/hf-cache
VLLM_HOST_PORT=8000

VLLM_MODEL_ID=cyankiwi/Qwen3.6-27B-AWQ-INT4
VLLM_SERVED_MODEL_NAME=Qwen3.6-27B-AWQ4
VLLM_COMMIT=v0.20.0

# W7900 / gfx1100 build pins.
W7900_GFX=gfx1100
W7900_ROCM_WHEEL_GFX=gfx1100
TORCH_ROCM_DATE=20260510

# Build behind proxy if needed.
#HTTP_PROXY=http://127.0.0.1:7890/
#HTTPS_PROXY=http://127.0.0.1:7890/
#http_proxy=http://127.0.0.1:7890/
#https_proxy=http://127.0.0.1:7890/

# Runtime layout. Start TP=2, then test TP=4 and TP=8.
W7900_VISIBLE_DEVICES=0,1
VLLM_TENSOR_PARALLEL_SIZE=2

VLLM_KV_CACHE_DTYPE=fp8
VLLM_GPU_MEMORY_UTIL=0.80
VLLM_MAX_MODEL_LEN=131072
VLLM_MAX_NUM_BATCHED_TOKENS=16384
VLLM_MAX_NUM_SEQS=1
VLLM_DFLASH_N=8

# Set to 1 for AWQ4 target-only A/B without DFlash.
VLLM_DISABLE_DFLASH=0
