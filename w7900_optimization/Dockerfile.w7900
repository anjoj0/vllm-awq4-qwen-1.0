# W7900 vLLM AWQ4 + DFlash image.
#
# This is the W7900/gfx1100 build entrypoint. It mirrors the root Dockerfile
# but switches ROCm/Triton/PyTorch architecture targets from Strix Halo gfx1151
# to Radeon PRO W7900 gfx1100 and disables the Strix-specific HIP MMQ experiment
# by default.

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git \
      build-essential cmake ninja-build \
      aria2 tar xz-utils \
      libatomic1 libnuma-dev libgomp1 libelf1t64 \
      libdrm-dev zlib1g-dev libssl-dev \
      libgoogle-perftools4 \
      procps cargo rustc pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
ARG ROCM_MAJOR_VER=7
ARG GFX=gfx1100
ARG ROCM_WHEEL_GFX=gfx1100
ARG TORCH_ROCM_DATE=20260510
ARG VLLM_COMMIT=v0.20.0

COPY scripts/install_rocm_sdk.sh /tmp/install_rocm_sdk.sh
RUN chmod +x /tmp/install_rocm_sdk.sh && \
    ROCM_MAJOR_VER=${ROCM_MAJOR_VER} GFX=${GFX} /tmp/install_rocm_sdk.sh && \
    rm /tmp/install_rocm_sdk.sh

COPY --from=ghcr.io/astral-sh/uv:0.11.12 /uv /usr/local/bin/uv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=/opt/venv/bin:/opt/rocm/bin:/opt/rocm/llvm/bin:$PATH
RUN uv venv /opt/venv --python 3.12 && \
    uv pip install \
      pip==26.1.1 \
      wheel==0.47.0 \
      packaging==26.2 \
      setuptools==79.0.1

RUN uv pip install --pre \
      torch==2.13.0a0+rocm7.13.0a${TORCH_ROCM_DATE} \
      torchvision==0.27.0a0+rocm7.13.0a${TORCH_ROCM_DATE} \
      torchaudio==2.11.0+rocm7.13.0a${TORCH_ROCM_DATE} \
      triton==3.7.0+git31234c9b.rocm7.13.0a${TORCH_ROCM_DATE} \
      --index-url https://rocm.nightlies.amd.com/v2-staging/${ROCM_WHEEL_GFX}/ && \
    rm -rf /root/.cache/uv /root/.cache/pip

RUN uv pip install \
      cmake==4.3.2 \
      ninja==1.13.0 \
      numpy==2.4.4 \
      setuptools-scm==10.0.5 \
      setuptools-rust \
      scikit-build-core==0.12.2 \
      pybind11==3.0.4 \
      conch-triton-kernels==1.3

RUN git clone https://github.com/vllm-project/vllm.git /opt/vllm
WORKDIR /opt/vllm
RUN if [ -n "$VLLM_COMMIT" ]; then \
      echo "Pinning vLLM to ${VLLM_COMMIT}"; \
      git checkout "${VLLM_COMMIT}"; \
    else \
      echo "Tracking vLLM HEAD: $(git rev-parse --short HEAD)"; \
    fi

COPY scripts/patch_strix.py /opt/vllm/patch_strix.py
COPY w7900_optimization/patch_w7900.py /opt/vllm/patch_w7900.py
RUN python /opt/vllm/patch_strix.py && \
    python /opt/vllm/patch_w7900.py && \
    grep -q "Patch 24a" /opt/vllm/vllm/v1/core/kv_cache_utils.py && \
    grep -q "Patch 24b" /opt/vllm/vllm/model_executor/models/qwen3_dflash.py && \
    grep -q "Patch 24c" /opt/vllm/vllm/v1/worker/gpu_model_runner.py && \
    grep -q 'return "gfx1100"' /opt/vllm/vllm/platforms/rocm.py

COPY scripts/start_vllm_awq.sh /usr/local/bin/start-vllm-awq
RUN chmod +x /usr/local/bin/start-vllm-awq

ENV ROCM_HOME=/opt/rocm \
    ROCM_PATH=/opt/rocm \
    HIP_PATH=/opt/rocm \
    HIP_PLATFORM=amd \
    CMAKE_PREFIX_PATH=/opt/rocm \
    VLLM_TARGET_DEVICE=rocm \
    PYTORCH_ROCM_ARCH=gfx1100 \
    HIP_ARCHITECTURES=gfx1100 \
    GPU_TARGETS=gfx1100 \
    AMDGPU_TARGETS=gfx1100 \
    MAX_JOBS=8 \
    CC=/opt/rocm/llvm/bin/clang \
    CXX=/opt/rocm/llvm/bin/clang++

RUN export HIP_DEVICE_LIB_PATH=$(find /opt/rocm -type d -name bitcode -print -quit) && \
    echo "Building with bitcode: $HIP_DEVICE_LIB_PATH" && \
    export CMAKE_ARGS="-DROCM_PATH=/opt/rocm -DHIP_PATH=/opt/rocm -DGPU_TARGETS=gfx1100 -DHIP_ARCHITECTURES=gfx1100" && \
    uv pip install --no-build-isolation --no-deps -v . && \
    grep -q "Patch 24a" /opt/venv/lib/python3.12/site-packages/vllm/v1/core/kv_cache_utils.py && \
    grep -q "Patch 24b" /opt/venv/lib/python3.12/site-packages/vllm/model_executor/models/qwen3_dflash.py && \
    grep -q "Patch 24c" /opt/venv/lib/python3.12/site-packages/vllm/v1/worker/gpu_model_runner.py && \
    grep -q 'return "gfx1100"' /opt/venv/lib/python3.12/site-packages/vllm/platforms/rocm.py && \
    rm -rf /root/.cache/uv /root/.cache/pip /tmp/*

RUN TORCH_VER=$(python -c "import torch; print(torch.__version__)") && \
    TRITON_VER=$(python -c "import triton; print(triton.__version__)") && \
    printf "torch==%s\ntriton==%s\nconch-triton-kernels==1.3\n" "$TORCH_VER" "$TRITON_VER" > /tmp/constraints.txt && \
    python -c "from pathlib import Path; p=Path('/opt/vllm/requirements/rocm.txt'); s=p.read_text(); p.write_text(s.replace('conch-triton-kernels==1.2.1', 'conch-triton-kernels==1.3'))" && \
    uv pip install --no-build-isolation \
      -r /opt/vllm/requirements/common.txt \
      -r /opt/vllm/requirements/rocm.txt \
      --constraint /tmp/constraints.txt && \
    uv pip install --no-deps --force-reinstall numpy==2.4.4 conch-triton-kernels==1.3 && \
    rm -rf /root/.cache/uv /root/.cache/pip /tmp/constraints.txt

ENV LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64:/opt/rocm/llvm/lib \
    HIP_CLANG_PATH=/opt/rocm/llvm/bin \
    ROCBLAS_USE_HIPBLASLT=1 \
    TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1 \
    HIP_FORCE_DEV_KERNARG=1 \
    RAY_EXPERIMENTAL_NOSET_ROCR_VISIBLE_DEVICES=1 \
    LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libtcmalloc_minimal.so.4 \
    HSA_OVERRIDE_GFX_VERSION=11.0.0 \
    HSA_NO_SCRATCH_RECLAIM=1 \
    MIOPEN_FIND_MODE=FAST \
    FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE \
    VLLM_ROCM_USE_AITER=0 \
    VLLM_USE_TRITON_AWQ=1 \
    VLLM_DISABLE_COMPILE_CACHE=1 \
    AWQ_MMQ_ENABLE=0

WORKDIR /opt
CMD ["/bin/bash"]
