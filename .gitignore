# Secrets  -  only .env.template is committed
.env
*.env
.env.local
*.key
*.pem

# Research data (deep-research findings, may contain proprietary insight)
.research/

# Local working tree (cloned reference repos, scratch space)
tmp/
logs/

# Session history preserved locally but not shipped
.tests/

# Local helpers (qwen-cli, repo metadata)  -  kept hidden, not shipped
.tools/

# Benchmark output (regenerated each run)
test/*.json
test/results/
!test/results/accuracy/
!test/results/accuracy/20260618_awq4_dflash_vs_bf16_5bench_comparison.md
!test/results/accuracy/20260618_awq4_dflash_vs_bf16_5bench_comparison.json
!test/results/accuracy/accuracy_summary_current.md
test/results/accuracy/**/*.jsonl
test/results/accuracy/**/*.log
test/results/accuracy/**/*.pid
test/results/accuracy/full_*/
!test/results/readme_verification/
!test/results/readme_verification/**
!test/results/context_pressure/
!test/results/context_pressure/**
test/results/context_pressure/*.env
!test/results/video_demo/
!test/results/video_demo/**
!test/results/
!test/results/competition/
!test/results/competition/**

# JIT caches (regenerated each run, large)
.triton-cache/
.vllm-cache/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
.venv-lm-eval/
venv/

# C/HIP custom-op build artifacts (rebuilt on demand inside the container)
csrc/**/build/
csrc/**/*.so
# hipify auto-generates *_hip.{hip,cpp,h} alongside the originals; only commit the originals
csrc/**/*_hip.hip
csrc/**/*_hip.cpp
csrc/**/*_hip.h

# Scratch session notes
session.txt

# Claude Code local config / scheduled-task state (per-project, not shared)
.claude/

# Editors / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db

# Logs / tmp
*.log
*.tmp
*.pid
*.core
core.*
*.orig

# Model weights should never be in the repo
*.safetensors
*.gguf
*.bin
models/

# W7900 runtime/profiler output; only curated reports belong in docs/
w7900_optimization/results/
w7900_optimization/longdoc_sanity/results/
w7900_optimization/.rocprofv3/
.rocprofv3/
