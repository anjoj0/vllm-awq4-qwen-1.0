# Strix Halo / gfx1151: qualified Qwen27B shapes (checked 2026-10-27).
# Host model cache must contain hub/models--.../snapshots/.
VLLM_HOST_MODELS_DIR=/absolute/path/to/hf-cache
VLLM_UPSTREAM_IMAGE=vllm/vllm-openai-rocm:v0.32.0@sha256:14f6a575e1fb0a580b0f633c09e06f648709d60405b85f6a7ff3f80d49f39905
# Use a separate tag for an MMQ build so the upstream baseline stays available.
VLLM_IMAGE=vllm-awq4-qwen:optimized-v0320
VLLM_HOST_PORT=8000

# Existing Qwen3.6 AWQ-INT4 target, compressed-tensors, group_size=32.
VLLM_MODEL_ID=cyankiwi/Qwen3.6-27B-AWQ-INT4
VLLM_SERVED_MODEL_NAME=Qwen3.6-27B-AWQ4

# none | dflash | dspark. Change configuration, then recreate the container.
# Empty draft ID selects the matching default for the chosen method.
# DSpark default: abstract-extraordinary/Qwen3.6-27B-DSpark (community).
VLLM_SPEC_METHOD=dflash
VLLM_DRAFT_MODEL_ID=
# This machine's v0.32 decode checks select N=4 for DFlash and DSpark.
# The optional DFlash2 checkpoint requires N=7 and BF16; use its own profile.
VLLM_SPEC_TOKENS=4
VLLM_DTYPE=half

# Reuse shared prefixes; set 0 for controlled cache-off comparisons.
# vLLM 0.32 already defaults to enabled; the launcher makes this explicit.
VLLM_ENABLE_PREFIX_CACHING=1

# Conservative first-boot profile; extend context after on-device validation.
VLLM_ENFORCE_EAGER=1
# Full decode graphs passed an earlier check without a meaningful speed gain.
VLLM_DECODE_GRAPHS=0
VLLM_GPU_MEMORY_UTIL=0.55
VLLM_MAX_NUM_SEQS=1
VLLM_MAX_NUM_BATCHED_TOKENS=8192
VLLM_MAX_MODEL_LEN=32768
VLLM_KV_CACHE_DTYPE=auto
# Minimum for the measured DFlash N=4 profile; vLLM raises the physical block
# to 832 on this hybrid model. Empty restores upstream auto alignment.
VLLM_BLOCK_SIZE=64

# Narrow gfx1151 / FP16 / group32 target-shape optimizations.
# Roll back with stable-v0320 and all five flags set to 0.
VLLM_QWEN27B_PREFILL_TILES=1
VLLM_QWEN27B_PREFILL_ROCBLAS=1
VLLM_QWEN27B_DOWN_KMAJOR=1
VLLM_QWEN27B_PREFILL_ATTN=1
VLLM_QWEN27B_VERIFY_ATTN=1

# 0: upstream RDNA kernels. 1: compile/register the project's HIP MMQ kernel.
# This is a build option: rebuild the image after changing it.
VLLM_ENABLE_PROJECT_MMQ=0
AWQ_MMQ_DECODE_BACKEND=triton
AWQ_MMQ_SMALL_M_THRESHOLD=32
